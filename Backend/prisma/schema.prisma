// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  fname            String?
  lname            String?
  dob              DateTime?
  phone            String?
  gender           String?
  city             String?
  avatarUrl        String?
  resetToken       String?
  resetTokenExpire DateTime?
  role             Role         @default(USER)
  isactive         ActiveStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

enum Role {
  ADMIN
  USER
}

enum ActiveStatus {
  ACTIVE
  DEACTIVE
  DELETED
  SUSPENDED
}

